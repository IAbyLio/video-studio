# Copia este archivo como .env (en la raíz de la carpeta) y completa SOLO las cuentas que tengas.
# .env está en .gitignore: nunca se sube. Escribe las claves tú, en tu editor; no las pegues en el chat de la IA.
# Comprobación sin gastar: node scripts/comprobar-cuentas.mjs          (solo formato, sin red)
#                          node scripts/comprobar-cuentas.mjs --en-linea (una consulta gratuita por cuenta)

# --- ElevenLabs: clon de voz y efectos de sonido generados (módulos voz y sonido) ---
# elevenlabs.io → Profile → API Keys. Empieza por "sk_".
ELEVENLABS_API_KEY=

# --- HeyGen: avatar de vídeo (módulo avatar) ---
# app.heygen.com → Settings → API. Cadena larga sin espacios.
HEYGEN_API_KEY=

# --- IA de vídeo para ganchos generados (módulo ganchos-ia) ---
# Solo lo que uses. El repo no llama a estas APIs por su cuenta: el módulo trabaja con el clip que generes
# en la plataforma (Higgsfield, Seedance vía la plataforma que tengas, etc.). Si quieres que la IA consulte
# tu saldo o lance generaciones por API, di cuál y lo vemos juntos.
HIGGSFIELD_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
