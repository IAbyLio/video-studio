# Dependencias
node_modules/

# Claves y configuración local (nunca se suben)
.env
.env.*
!.env.example
# IA:claude,fuente
.claude/settings.local.json
# /IA

# Lo que instala el onboarding desde su fuente oficial (no es parte de este repo)
# IA:claude,fuente
.claude/skills/hyperframes/
.claude/skills/hyperframes-cli/
.claude/skills/hyperframes-registry/
.claude/skills/media-use/
.claude/skills/gsap-*/
# /IA
# IA:codex,otra,fuente
.agents/skills/hyperframes*/
.agents/skills/media-use/
.agents/skills/gsap-*/
# /IA
skills-lock.json

# Renders, fotogramas y cachés
renders/
**/renders/
.hyperframes/
**/.hyperframes/
.cache/
**/.thumbnails/
**/.waveform-cache/
*.log

# Material en bruto y medios pesados de tus proyectos
raw/
**/raw/
proyectos/*/bruto/
proyectos/*/assets/media/

# Tus proyectos son tuyos: si quieres versionarlos, borra esta línea
proyectos/*
!proyectos/_plantilla/

# Intermedios de SFX generados (sfx-generate.mjs baja mp3 y lo convierte a wav)
modulos/sonido/sfx/*.mp3

# Sistema
.DS_Store
Thumbs.db

# Voz de prueba del demo del muñeco (la genera cada uno en su máquina; sin ella el demo usa bocas sintéticas)
modulos/personaje-3d/muneco/demo/assets/voz.*
modulos/personaje-3d/muneco/demo/assets/boca-data.js
modulos/personaje-3d/muneco/demo/assets/boca.json
